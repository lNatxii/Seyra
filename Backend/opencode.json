{
  "$schema": "https://opencode.ai/config.json",
  "model": "meta/muse-spark-1.3",
  "websearch": {
    "provider": "exa"
  },
  "mcp": {
    "servers": {
      "seyra": {
        "type": "local",
        "command": [
          "node",
          "{env:SEYRA_BACKEND_DIR}/bridge/dist/index.js"
        ],
        "cwd": "{env:SEYRA_BACKEND_DIR}",
        "environment": {
          "META_API_KEY": "{env:META_API_KEY}"
        },
        "disabled": false,
        "codemode": false,
        "timeout": {
          "execution": 25000
        }
      }
    }
  },
  "agents": {
    "seyra": {
      "description": "Conversation and Unity scene assistant in Play Mode",
      "mode": "primary",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "seyra_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*.env",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.env.*",
          "effect": "deny"
        },
        {
          "action": "grep",
          "resource": "*.env",
          "effect": "deny"
        },
        {
          "action": "grep",
          "resource": "*.env.*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "{env:SEYRA_OPENCODE_DATA_DIR}/tool-output/*",
          "effect": "allow"
        }
      ],
      "system": "{file:./prompts/seyra.md}"
    },
    "seyra_glm": {
      "description": "Conversation and Unity scene assistant in Play Mode",
      "mode": "primary",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "seyra_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*.env",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.env.*",
          "effect": "deny"
        },
        {
          "action": "grep",
          "resource": "*.env",
          "effect": "deny"
        },
        {
          "action": "grep",
          "resource": "*.env.*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "{env:SEYRA_OPENCODE_DATA_DIR}/tool-output/*",
          "effect": "allow"
        }
      ],
      "system": "{file:./prompts/seyra.md}",
      "model": "helmcode/glm5.3-flash"
    },
    "seyra_deepseek": {
      "description": "Conversation and Unity scene assistant in Play Mode",
      "mode": "primary",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "seyra_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*.env",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.env.*",
          "effect": "deny"
        },
        {
          "action": "grep",
          "resource": "*.env",
          "effect": "deny"
        },
        {
          "action": "grep",
          "resource": "*.env.*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "{env:SEYRA_OPENCODE_DATA_DIR}/tool-output/*",
          "effect": "allow"
        }
      ],
      "system": "{file:./prompts/seyra.md}",
      "model": "opencode/deepseek-v4.1-flash-free"
    },
    "seyra_zai": {
      "description": "Conversation and Unity scene assistant in Play Mode",
      "mode": "primary",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "seyra_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*.env",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.env.*",
          "effect": "deny"
        },
        {
          "action": "grep",
          "resource": "*.env",
          "effect": "deny"
        },
        {
          "action": "grep",
          "resource": "*.env.*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "{env:SEYRA_OPENCODE_DATA_DIR}/tool-output/*",
          "effect": "allow"
        }
      ],
      "system": "{file:./prompts/seyra.md}",
      "model": "zai-coding-plan/glm-5.3-flash"
    }
  },
  "providers": {
    "helmcode": {
      "name": "Helmcode",
      "env": [
        "HELMCODE_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.helmcode.com/v1"
      },
      "models": {
        "glm5.3-flash": {
          "name": "GLM 5.3 Flash"
        }
      }
    },
    "meta": {
      "name": "Meta Model API",
      "env": [
        "META_API_KEY"
      ],
      "package": "@opencode/ai/providers/meta/responses",
      "settings": {
        "baseURL": "https://api.meta.ai/v1"
      },
      "models": {
        "muse-spark-1.3": {
          "name": "Muse Spark 1.3"
        }
      }
    }
  }
}
