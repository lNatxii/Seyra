{
  "$schema": "https://opencode.ai/config.json",
  "model": "helmcode/glm5.3-flash",
  "websearch": {
    "provider": "exa"
  },
  "mcp": {
    "servers": {
      "seyra": {
        "type": "local",
        "command": [
          "node",
          "C:/Proyectos/Seyra/Backend/bridge/dist/index.js"
        ],
        "cwd": "C:/Proyectos/Seyra/Backend",
        "disabled": false,
        "codemode": false,
        "timeout": {
          "execution": 15000
        }
      }
    }
  },
  "agents": {
    "seyra": {
      "description": "Conversation and Unity scene assistant in Play Mode",
      "mode": "primary",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "seyra_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*.env",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.env.*",
          "effect": "deny"
        },
        {
          "action": "grep",
          "resource": "*.env",
          "effect": "deny"
        },
        {
          "action": "grep",
          "resource": "*.env.*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "{env:USERPROFILE}/.local/share/opencode/tool-output/*",
          "effect": "allow"
        }
      ],
      "system": "{file:./prompts/seyra.md}"
    },
    "seyra_deepseek": {
      "description": "Conversation and Unity scene assistant in Play Mode",
      "mode": "primary",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "seyra_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*.env",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.env.*",
          "effect": "deny"
        },
        {
          "action": "grep",
          "resource": "*.env",
          "effect": "deny"
        },
        {
          "action": "grep",
          "resource": "*.env.*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "{env:USERPROFILE}/.local/share/opencode/tool-output/*",
          "effect": "allow"
        }
      ],
      "system": "{file:./prompts/seyra.md}",
      "model": "opencode/deepseek-v4.1-flash-free"
    }
  },
  "providers": {
    "helmcode": {
      "name": "Helmcode",
      "env": [
        "HELMCODE_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.helmcode.com/v1"
      },
      "models": {
        "glm5.3-flash": {
          "name": "GLM 5.3 Flash"
        }
      }
    }
  }
}
